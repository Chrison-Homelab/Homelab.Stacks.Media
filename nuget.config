<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- nuget.org ONLY, deliberately. Fallout 10.4 is published publicly there, so this
         stack's build needs no private feed and no GITHUB_PACKAGES_PAT — which is what
         lets it run on a GitHub-hosted runner. The superproject still points Fallout.* at
         the Fallout-build GitHub Packages feed because it is pinned to an old
         2026.1.0-preview edge build; that pin is being retired separately. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
